<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Portfolio of <%= content.site.name %> — <%= content.site.role %>." />
  <title><%= content.site.name %> — <%= content.site.role %></title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <header class="site-header" id="top">
    <a class="brand" href="#top" aria-label="Back to top"><%= content.site.name.split(' ')[0].toUpperCase() %><span>®</span></a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="main-nav">Menu</button>
    <nav id="main-nav" class="main-nav" aria-label="Primary navigation">
      <a href="#about">About</a>
      <a href="#work">Work</a>
      <a href="#experience">Experience</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <main>
    <section class="hero section-dark" aria-labelledby="hero-title">
      <div class="hero-copy reveal">
        <p class="eyebrow"><%= content.site.heroEyebrow %></p>
        <h1 id="hero-title"><%= content.site.heroTitle %></h1>
        <p class="hero-intro"><%= content.site.heroIntro %></p>
        <div class="hero-actions">
          <a class="button button-light" href="#work">Explore selected work</a>
          <% if (content.site.behance) { %><a class="text-link" href="<%= content.site.behance %>" target="_blank" rel="noreferrer">Behance ↗</a><% } %>
        </div>
      </div>
      <div class="hero-art reveal" aria-hidden="true">
        <div class="orbit orbit-a"></div>
        <div class="orbit orbit-b"></div>
        <img src="<%= content.site.heroImage %>" alt="" />
        <div class="floating-tag">PORTFOLIO / <%= year %></div>
      </div>
      <div class="hero-index" aria-hidden="true">01</div>
    </section>

    <section class="about section-cream" id="about" aria-labelledby="about-title">
      <div class="section-number">02</div>
      <div class="about-grid">
        <div class="portrait-wrap reveal">
          <img src="<%= content.site.portraitImage %>" alt="Portrait of <%= content.site.name %>" />
          <span class="portrait-caption"><%= content.site.role %></span>
        </div>
        <div class="about-copy reveal">
          <p class="eyebrow dark"><%= content.about.eyebrow %></p>
          <h2 id="about-title"><%= content.about.title %></h2>
          <p class="lead"><%= content.about.lead %></p>
          <p><%= content.about.body %></p>
          <div class="skills" aria-label="Technical skills">
            <% content.skills.forEach(skill => { %><span><%= skill %></span><% }) %>
          </div>
        </div>
      </div>
      <% if (content.about.statement) { %><blockquote class="statement reveal">“<%= content.about.statement %>”</blockquote><% } %>
    </section>

    <section class="work section-paper" id="work" aria-labelledby="work-title">
      <div class="work-heading reveal">
        <div>
          <p class="eyebrow dark">Selected works</p>
          <h2 id="work-title">A visual archive<br/>of ideas in motion.</h2>
        </div>
        <p>Projects from illustration, mascot design, printing, apparel, character work, packaging and social media.</p>
      </div>

      <div class="filter-bar reveal" role="group" aria-label="Filter portfolio projects">
        <button class="filter is-active" data-filter="all">All</button>
        <button class="filter" data-filter="illustration">Illustration</button>
        <button class="filter" data-filter="mascot">Mascot</button>
        <button class="filter" data-filter="printing">Printing</button>
        <button class="filter" data-filter="apparel">Apparel</button>
        <button class="filter" data-filter="character">Character</button>
        <button class="filter" data-filter="packaging">Packaging</button>
        <button class="filter" data-filter="social">Social Media</button>
      </div>

      <div class="project-grid" id="project-grid">
        <% projects.forEach(project => { %>
          <article class="project-card reveal" data-category="<%= project.category %>" data-id="<%= project.id %>" tabindex="0" role="button" aria-label="Open project <%= project.title %>">
            <img src="<%= project.cover %>" alt="<%= project.title %>" loading="lazy" />
            <div class="project-card-overlay"><span><%= project.label %></span><h3><%= project.title %></h3></div>
          </article>
        <% }) %>
      </div>
    </section>

    <% if (featured) { %>
    <section class="feature section-rust" aria-labelledby="feature-title">
      <div class="feature-media reveal">
        <img src="<%= featured.cover %>" alt="<%= featured.title %>" loading="lazy" />
      </div>
      <div class="feature-copy reveal">
        <p class="eyebrow">Featured project</p>
        <h2 id="feature-title"><%= featured.title %></h2>
        <p><%= featured.description %></p>
        <div class="feature-meta"><% featured.tags.slice(0,3).forEach(tag => { %><span><%= tag %></span><% }) %></div>
        <button class="button button-light open-project" data-project="<%= featured.id %>">View project</button>
      </div>
    </section>
    <% } %>

    <section class="experience section-ink" id="experience" aria-labelledby="experience-title">
      <div class="experience-title reveal">
        <p class="eyebrow">Experience</p>
        <h2 id="experience-title">A practice built across design, illustration & visual communication.</h2>
      </div>
      <div class="timeline reveal">
        <% content.experiences.forEach(item => { %>
          <article><span><%= item.period %></span><h3><%= item.title %></h3><p><%= item.company %></p></article>
        <% }) %>
      </div>
    </section>

    <section class="achievements section-cream" aria-labelledby="achievement-title">
      <div class="section-number">03</div>
      <div class="achievements-head reveal">
        <p class="eyebrow dark">Selected recognition</p>
        <h2 id="achievement-title">Competition highlights.</h2>
      </div>
      <div class="achievement-grid reveal">
        <% content.achievements.forEach(item => { %>
          <article><b><%= item.rank %></b><span><%= item.title %></span></article>
        <% }) %>
      </div>
    </section>

    <section class="contact section-dark" id="contact" aria-labelledby="contact-title">
      <div class="contact-art reveal"><img src="<%= content.site.contactImage %>" alt="Thank you artwork" loading="lazy" /></div>
      <div class="contact-copy reveal">
        <p class="eyebrow"><%= content.site.availability %></p>
        <h2 id="contact-title">Let’s create something memorable.</h2>
        <p>For illustration, graphic design, branding and visual storytelling enquiries.</p>
        <div class="contact-links">
          <% if (content.site.email) { %><a href="mailto:<%= content.site.email %>"><%= content.site.email %> ↗</a><% } %>
          <% if (content.site.phone) { %><a href="tel:<%= content.site.phone.replace(/[^+\d]/g, '') %>"><%= content.site.phone %> ↗</a><% } %>
          <% if (content.site.instagram) { %><a href="<%= content.site.instagram %>" target="_blank" rel="noreferrer"><%= content.site.instagramLabel || 'Instagram' %> ↗</a><% } %>
          <% if (content.site.behance) { %><a href="<%= content.site.behance %>" target="_blank" rel="noreferrer"><%= content.site.behanceLabel || 'Behance' %> ↗</a><% } %>
        </div>
      </div>
      <div class="contact-big" aria-hidden="true">THANK<br/>YOU</div>
    </section>
  </main>

  <footer>
    <span>© <%= year %> <%= content.site.name %></span>
    <a href="#top">Back to top ↑</a>
  </footer>

  <dialog class="project-dialog" id="project-dialog" aria-labelledby="dialog-title">
    <button class="dialog-close" aria-label="Close project">×</button>
    <div class="dialog-content">
      <div class="dialog-gallery" id="dialog-gallery"></div>
      <div class="dialog-copy">
        <p class="eyebrow dark" id="dialog-category"></p>
        <h2 id="dialog-title"></h2>
        <p id="dialog-description"></p>
        <div id="dialog-tags" class="skills"></div>
      </div>
    </div>
  </dialog>

  <script src="/frontend.js" defer></script>
</body>
</html>
